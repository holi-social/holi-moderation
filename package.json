{
  "name": "@holi/moderation",
  "private": true,
  "packageManager": "yarn@4.4.1",
  "workspaces": [
    "apps/backend",
    "apps/frontend",
    "apps/eventListener"
  ],
  "scripts": {
    "start": "npx ts-node mprocs-start.ts",
    "start-fake": "npx ts-node mprocs-start-fake.ts",
    "lint": "eslint \"apps/*/{src,test}/**/*.ts\"",
    "test": "yarn workspaces foreach -Ap run test --passWithNoTests",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json}\"",
    "build": "yarn workspaces foreach -Ap run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.7.0",
    "@types/eslint__js": "^8.42.3",
    "@types/node": "^20.11.0",
    "docker-compose": "^0.24.8",
    "dotenv": "^16.4.5",
    "eslint": "^9.7.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jest": "^28.6.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react-refresh": "^0.4.8",
    "prettier": "^3.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3",
    "typescript-eslint": "8.0.0-alpha.44"
  },
  "prettier": {
    "printWidth": 120,
    "semi": false,
    "singleQuote": true
  }
}
